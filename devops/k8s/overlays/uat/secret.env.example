# copy เป็น secret.env (อยู่ใน .gitignore) แล้วใส่ค่าจริง · prod กับ uat ต้องใช้ค่าคนละชุด
# รหัสผ่าน PostgreSQL (ใช้ทั้งตอนสร้าง DB และที่ backend ต่อเข้า)
DB_PASSWORD=
# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 32  (ห้ามเปลี่ยนหลังมีข้อมูลใบหน้าแล้ว ไม่งั้นถอดรหัส embedding เดิมไม่ได้)
FACE_EMBEDDING_KEY=
# openssl rand -hex 32  (backend และ AI Service ใช้ค่าเดียวกัน)
INTERNAL_API_KEY=
# E2 (uat เท่านั้น): รหัสผ่านเริ่มต้นของบัญชีนักศึกษาที่สร้างตอนเพิ่มเข้ากลุ่ม · ไม่ใส่บรรทัดนี้ = สร้างบัญชีใหม่ไม่ได้ (เพิ่มได้แค่คนที่มีบัญชีแล้ว)
#   ใช้ค่าเดียวกับบัญชีทดสอบของ uat (หน้า Login กรอกให้) หรือ openssl rand -hex 12 · ห้ามใส่ใน secret.env ของ prod
NEW_STUDENT_PASSWORD=
