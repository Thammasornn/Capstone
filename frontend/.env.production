# K3s namespace Production: npm run build
# เว็บ: https://bscit.sit.kmutt.ac.th/capstone26/cp26ms3/prod/
# bscit (NGINX ของคณะ) ตัด /capstone26/cp26ms3 ออกแล้วส่งมา VM → VM ได้ /prod/...
#   VITE_BASE = path ที่เบราว์เซอร์เห็น (assets / router / API)
#   APP_PATH  = path ที่มาถึง VM (NGINX location) · ต้องตรงกับ Ingress ใน devops/k8s/overlays/prod (deploy.sh ตรวจ)
#   APP_PATH ไม่มี prefix VITE_ จึงไม่เข้า bundle — Dockerfile / deploy.sh อ่านจากไฟล์นี้เอง
VITE_BASE=/capstone26/cp26ms3/prod/
APP_PATH=/prod/
# NGINX ใน container FE ได้ /prod/api/* (bscit ตัด prefix แล้ว) ส่งต่อไป Spring Boot (env BACKEND_URL ของ container)
VITE_API_BASE_URL=/capstone26/cp26ms3/prod/api
VITE_MOCK_MODE=off
# ห้ามแสดงบัญชีทดสอบใน Production (ไม่มีข้อมูล mock)
VITE_SHOW_TEST_ACCOUNTS=false
