# เครื่องนักพัฒนา: npm run dev → http://localhost:5173
VITE_BASE=/
# เรียกแบบ relative เสมอ → Vite proxy ส่งต่อไป DEV_BACKEND_URL (ไม่ต้องตั้ง CORS)
VITE_API_BASE_URL=/api
# Backend ที่ Vite proxy ส่ง /api ไปหา (ไม่ขึ้นต้นด้วย VITE_ จึงไม่ถูกใส่ใน bundle)
# ต่อ backend บน VM หรือเครื่องเพื่อน: ตั้งใน .env.development.local เช่น DEV_BACKEND_URL=http://10.0.0.5:8081
DEV_BACKEND_URL=http://localhost:8081
# off = ต่อ Backend จริง · all = mock เฉพาะ API v1.0 (5.1–5.11) ไม่ต้องรัน Backend (หน้า Room / จัดการรายวิชาใช้ไม่ได้)
VITE_MOCK_MODE=off
