# K3s namespace UAT: npm run build:uat
# path เดียวที่ต้องแก้ (Dockerfile / deploy.sh อ่านค่านี้) · ต้องตรงกับ Ingress ใน devops/k8s/overlays/uat
# https://bscit.sit.kmutt.ac.th/capstone26/uat/ (คณะ forward มา VM) = http://cp26ms3.sit.kmutt.ac.th/capstone26/uat/
VITE_BASE=/capstone26/uat/
# NGINX ใน container FE ส่ง /capstone26/uat/api/* ต่อไป Spring Boot (env BACKEND_URL ของ container)
VITE_API_BASE_URL=/capstone26/uat/api
VITE_MOCK_MODE=off
# แสดงบัญชีทดสอบ (ข้อมูล mock ใน DB) ที่หน้า Login · Production ต้องเป็น false
VITE_SHOW_TEST_ACCOUNTS=true
