# K3s namespace UAT: npm run build:uat
# เว็บ: https://bscit.sit.kmutt.ac.th/capstone26/cp26ms3/uat/
# bscit (NGINX ของคณะ) ตัด /capstone26/cp26ms3 ออกแล้วส่งมา VM → VM ได้ /uat/...
#   VITE_BASE = path ที่เบราว์เซอร์เห็น (assets / router / API)
#   APP_PATH  = path ที่มาถึง VM (NGINX location) · ต้องตรงกับ Ingress ใน devops/k8s/overlays/uat (deploy.sh ตรวจ)
#   APP_PATH ไม่มี prefix VITE_ จึงไม่เข้า bundle — Dockerfile / deploy.sh อ่านจากไฟล์นี้เอง
VITE_BASE=/capstone26/cp26ms3/uat/
APP_PATH=/uat/
# NGINX ใน container FE ได้ /uat/api/* (bscit ตัด prefix แล้ว) ส่งต่อไป Spring Boot (env BACKEND_URL ของ container)
VITE_API_BASE_URL=/capstone26/cp26ms3/uat/api
VITE_MOCK_MODE=off
# แสดงบัญชีทดสอบ (ข้อมูล mock ใน DB) ที่หน้า Login · Production ต้องเป็น false
VITE_SHOW_TEST_ACCOUNTS=true
